# aisa environment variables.
# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Core ---

# Path to the private engagements repo (repo 2).
# If unset, skills fall back to ./projects/ (assumes symlink/junction is configured).
AISA_ENGAGEMENTS_ROOT=

# Hook guard mode for library/ writes: "enforce" (block) or "log" (warn only).
# Default: enforce (set in .claude/settings.json env). For administrative
# authoring of library/ content, prefer out-of-band git edits; if you must
# work in-session, temporarily set "log" here or in your shell.
AISA_GUARD_MODE=enforce

# Kernel version (informational; mirrors .claude/settings.json env).
AISA_KERNEL_VERSION=0.2.0

# --- MCP (NOT used in MVP; fill only when a SharePoint MCP server is configured) ---
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
