{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "handoff-pack/1",
 "title": "Capacidades de workflow declaradas por um pack (pack.yaml)",
 "description": "Ausência de declaração = não suportado; nunca se infere compatibilidade.",
 "type": "object",
 "required": [
  "supported_workflow_profiles",
  "supported_routes",
  "design_contract_version"
 ],
 "properties": {
  "supported_workflow_profiles": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "supported_routes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "enum": [
     "solution-choice",
     "platform-constrained",
     "change-impact"
    ]
   }
  },
  "design_contract_version": {
   "type": "integer",
   "minimum": 1
  }
 }
}
