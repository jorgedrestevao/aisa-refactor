{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "handoff-state/1",
 "title": "Bloco `workflow` de _state.json — perfil handoff-v1",
 "description": "Dono: workflow.py (publicado pelo coordenador). Campos desconhecidos preservam-se. platform-constrained exige authority_ref (regra em workflow.validate_profile).",
 "type": "object",
 "required": [
  "profile",
  "schema_version",
  "route",
  "route_revision",
  "route_basis",
  "route_history"
 ],
 "properties": {
  "profile": {
   "const": "handoff-v1"
  },
  "schema_version": {
   "const": "handoff-state/1"
  },
  "route": {
   "enum": [
    "solution-choice",
    "platform-constrained",
    "change-impact"
   ]
  },
  "route_revision": {
   "type": "integer",
   "minimum": 1
  },
  "route_basis": {
   "$ref": "#/$defs/basis"
  },
  "route_history": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "route_revision",
     "route",
     "route_basis",
     "superseded_reason"
    ],
    "properties": {
     "route_revision": {
      "type": "integer",
      "minimum": 1
     },
     "route": {
      "enum": [
       "solution-choice",
       "platform-constrained",
       "change-impact"
      ]
     },
     "route_basis": {
      "$ref": "#/$defs/basis"
     },
     "superseded_reason": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 },
 "$defs": {
  "basis": {
   "type": "object",
   "required": [
    "justification",
    "source_refs",
    "authority_ref"
   ],
   "properties": {
    "justification": {
     "type": "string",
     "minLength": 1
    },
    "source_refs": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "authority_ref": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  }
 }
}
