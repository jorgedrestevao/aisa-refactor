    {
     "kind": "positive",
     "given": "um pedido de outro membro da equipa",
     "when": "a chefia aprova",
     "then": "o pedido fica aprovado"
    },
    {
     "kind": "negative",
     "given": "um pedido feito pela própria chefia",
     "when": "a chefia tenta aprovar pela interface ou pela API",
     "then": "o servidor recusa e o estado não muda"
    }
   ],
