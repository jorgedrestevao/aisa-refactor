{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "handoff-scope/1",
 "title": "Âmbito autorizado (_design/scope.json)",
 "description": "Cada SCOPE-NNNN: o que inclui (linhas da SU, jornadas) e o que exclui, cada exclusão com a autorização (D-NNN). Publicado só por inventory.py (coordenador); revisões imutáveis em _design/history/ (handoff-v1 F6, Q3).",
 "type": "object",
 "required": [
  "schema_version",
  "engagement_id",
  "revision",
  "based_on",
  "items"
 ],
 "properties": {
  "schema_version": {
   "const": "handoff-scope/1"
  },
  "engagement_id": {
   "type": "string",
   "minLength": 1
  },
  "revision": {
   "type": "integer",
   "minimum": 1
  },
  "based_on": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "ref"
    ],
    "properties": {
     "ref": {
      "type": "string",
      "minLength": 1
     },
     "revision": {
      "type": [
       "integer",
       "string"
      ]
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     }
    }
   }
  },
  "retired_ids": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "includes",
     "excludes"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^SCOPE-\\d{4}$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "includes": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "ref",
        "reason"
       ],
       "properties": {
        "ref": {
         "type": "string",
         "minLength": 1
        },
        "reason": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     },
     "excludes": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "ref",
        "reason",
        "authorization_ref"
       ],
       "properties": {
        "ref": {
         "type": "string",
         "minLength": 1
        },
        "reason": {
         "type": "string",
         "minLength": 1
        },
        "authorization_ref": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     },
     "authorized_by": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  }
 }
}
