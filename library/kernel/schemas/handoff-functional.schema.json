{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "handoff-functional/1",
 "title": "Contratos funcionais (_design/functional-contracts.json)",
 "description": "Semântica de comportamento TO-BE. Referencia ids do blueprint e da SU; não redefine campos. Campos de conteúdo ausentes exigem entrada em not_applicable com motivo não vazio (o motivo valida-se aqui; a exigência de presença por campo é do validador de F5). IDs nunca reutilizados: retired_ids.",
 "type": "object",
 "required": [
  "schema_version",
  "engagement_id",
  "revision",
  "based_on",
  "items"
 ],
 "properties": {
  "schema_version": {
   "const": "handoff-functional/1"
  },
  "engagement_id": {
   "type": "string",
   "minLength": 1
  },
  "revision": {
   "type": "integer",
   "minimum": 1
  },
  "based_on": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "ref"
    ],
    "properties": {
     "ref": {
      "type": "string",
      "minLength": 1
     },
     "revision": {
      "type": [
       "integer",
       "string"
      ]
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     }
    }
   }
  },
  "retired_ids": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^FC-[0-9]{4}$"
   }
  },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "purpose",
     "scope_id",
     "semantic_origin",
     "owner_role",
     "requirement_refs",
     "architecture_refs",
     "authorization_ref",
     "publication_status"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^FC-[0-9]{4}$"
     },
     "journey_id": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^J-[0-9]{4}$"
     },
     "purpose": {
      "type": "string",
      "minLength": 1
     },
     "scope_id": {
      "type": "string",
      "minLength": 1
     },
     "semantic_origin": {
      "enum": [
       "observed_as_is",
       "proposed_to_be",
       "authorized_to_be"
      ]
     },
     "owner_role": {
      "type": "string",
      "minLength": 1
     },
     "requirement_refs": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "architecture_refs": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "authorization_ref": {
      "type": [
       "string",
       "null"
      ]
     },
     "actors": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "preconditions": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "trigger": {
      "type": "string"
     },
     "inputs": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "field_ref",
        "required"
       ],
       "properties": {
        "field_ref": {
         "type": "string",
         "minLength": 1
        },
        "required": {
         "type": "boolean"
        }
       }
      }
     },
     "rule": {
      "type": "string"
     },
     "postconditions": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "exceptions": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "condition",
        "behavior"
       ],
       "properties": {
        "condition": {
         "type": "string",
         "minLength": 1
        },
        "behavior": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     },
     "acceptance_examples": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "given",
        "when",
        "then"
       ],
       "properties": {
        "given": {
         "type": "string",
         "minLength": 1
        },
        "when": {
         "type": "string",
         "minLength": 1
        },
        "then": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     },
     "open_refs": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "delegated_choices": {
      "type": "array"
     },
     "proof_refs": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "not_applicable": {
      "type": "object",
      "additionalProperties": {
       "type": "string",
       "minLength": 1
      }
     },
     "publication_status": {
      "enum": [
       "draft",
       "received",
       "integrated",
       "superseded"
      ]
     }
    }
   }
  }
 }
}
