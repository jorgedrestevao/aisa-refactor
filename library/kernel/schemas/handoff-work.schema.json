{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "handoff-work/1",
 "title": "Checkpoint do trabalho do próprio aisa (_work/checkpoint.json)",
 "description": "Só referências e estado de trabalho; nunca copia SU, decisões ou blueprint. Publicado pelo coordenador.",
 "type": "object",
 "required": [
  "schema_version",
  "engagement_id",
  "revision",
  "profile",
  "route",
  "objective",
  "scope_refs",
  "authorization_refs",
  "last_integrated_operation",
  "active_task",
  "tasks",
  "results",
  "next_actions"
 ],
 "properties": {
  "schema_version": {
   "const": "handoff-work/1"
  },
  "engagement_id": {
   "type": "string",
   "minLength": 1
  },
  "revision": {
   "type": "integer",
   "minimum": 1
  },
  "profile": {
   "const": "handoff-v1"
  },
  "route": {
   "enum": [
    "solution-choice",
    "platform-constrained",
    "change-impact"
   ]
  },
  "objective": {
   "type": "string",
   "minLength": 1
  },
  "scope_refs": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "authorization_refs": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "last_integrated_operation": {
   "type": [
    "string",
    "null"
   ]
  },
  "active_task": {
   "type": [
    "string",
    "null"
   ]
  },
  "tasks": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "role",
     "state",
     "input_refs",
     "dependencies",
     "blocker_refs",
     "completion_criteria",
     "output_refs"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3,}$"
     },
     "role": {
      "type": "string",
      "minLength": 1
     },
     "state": {
      "enum": [
       "planned",
       "running",
       "blocked",
       "completed",
       "cancelled"
      ]
     },
     "input_refs": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "ref"
       ],
       "properties": {
        "ref": {
         "type": "string",
         "minLength": 1
        },
        "revision": {
         "type": [
          "integer",
          "string"
         ]
        },
        "sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        }
       }
      }
     },
     "dependencies": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "blocker_refs": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "output_refs": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     }
    }
   }
  },
  "results": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "task_id",
     "status",
     "freshness",
     "ref",
     "input_revision"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "task_id": {
      "type": "string",
      "minLength": 1
     },
     "status": {
      "enum": [
       "draft",
       "received",
       "integrated",
       "superseded"
      ]
     },
     "freshness": {
      "enum": [
       "current",
       "stale",
       "unverified"
      ]
     },
     "ref": {
      "type": "string",
      "minLength": 1
     },
     "input_revision": {
      "type": [
       "integer",
       "string"
      ]
     },
     "reason_not_integrated": {
      "type": "string"
     }
    }
   }
  },
  "next_actions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "action",
     "reason"
    ],
    "properties": {
     "action": {
      "type": "string",
      "minLength": 1
     },
     "reason": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}
